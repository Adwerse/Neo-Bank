# Copy this file to .env (frontend/, next to vite.config.ts) and fill in
# a real value. .env is gitignored (see the root .gitignore's bare ".env"
# pattern, which matches at every directory level).

# Stripe TEST-mode PUBLISHABLE key (pk_test_...) — the counterpart to the
# STRIPE_SECRET_KEY configured in the repo root .env for transfers-svc.
# Find it on the same Stripe test-mode dashboard. Public by nature (it's
# meant to ship in browser JS — Stripe.js uses it client-side to tokenize
# card details before they ever reach this app's own code), but still not
# hardcoded here: Vite bakes VITE_-prefixed env vars into the built bundle
# at build time, read via import.meta.env.VITE_STRIPE_PUBLISHABLE_KEY (see
# frontend/src/features/deposits/stripe.ts).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
