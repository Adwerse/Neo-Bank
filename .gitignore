# Compiled Go service binaries (each services/*/Dockerfile builds its own;
# these are never meant to be committed — see services/auth-svc/auth-svc.exe
# for the 28MB cautionary tale that prompted this file).
*.exe
/services/*/server

# Local secrets (real third-party credentials, e.g. STRIPE_SECRET_KEY —
# never commit these; see .env.example and README "Stripe-фондированные
# депозиты" for why this is treated differently from JWT_SECRET's harmless
# hardcoded dev value in docker-compose.yml).
.env
