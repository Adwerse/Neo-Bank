# Copy this file to .env (repo root, next to docker-compose.yml) and fill
# in real values. .env is gitignored — see README, "Stripe-фондированные
# депозиты: инфраструктура", for why a real third-party secret like this
# must never be committed (unlike JWT_SECRET's harmless hardcoded dev
# value elsewhere in docker-compose.yml).

# Stripe TEST-mode secret key (sk_test_...). Get one by creating a free
# Stripe account and switching the dashboard to test mode. Read once at
# startup by transfers-svc (STRIPE_SECRET_KEY) — the service refuses to
# start without it.
STRIPE_SECRET_KEY=sk_test_...

# Signs Stripe webhook deliveries (whsec_...) — a different secret from
# STRIPE_SECRET_KEY above, used only to verify that a POST to
# /webhooks/stripe actually came from Stripe. For local development this
# comes from the Stripe CLI, not the dashboard — see README,
# "Stripe-фондированные депозиты", "Локальная разработка вебхуков".
STRIPE_WEBHOOK_SECRET=whsec_...
